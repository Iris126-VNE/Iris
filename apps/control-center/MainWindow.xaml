<Window x:Class="IrisControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iris Control Center — Hosted Revit MCP"
        Height="680" Width="620"
        MinHeight="620" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Iris Control Center" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" />
                <TextBlock Text="Quản lý kết nối Hosted Revit MCP &amp; cài đặt Revit Add-in" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
            </StackPanel>
            <Border x:Name="StatusBadge" Grid.Column="1" VerticalAlignment="Center" Background="#1E293B" CornerRadius="16" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#F59E0B" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="Đang kiểm tra..." FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Server & API Key Card -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="1. Kết nối Server Hub" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10" />

                <TextBlock Text="Server URL" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                <TextBox x:Name="ServerUrlBox" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="API Key (phần mật khẩu trước dấu : trên Render)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <TextBox x:Name="ApiKeyBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tên máy (Alias)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <TextBox x:Name="MachineAliasBox" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Lưu &amp; Đồng bộ" Click="OnSaveSettingsClick" Margin="0,0,10,0" />
                    <Button Content="Kiểm tra Server" Background="#334155" Click="OnCheckServerClick" Margin="0,0,10,0" />
                    <Button Content="Copy MCP Config" Background="#0F766E" Click="OnCopyMcpConfigClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Revit Add-in Manager Card -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="2. Cài đặt Revit Thin Connector" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" />
                    <TextBlock x:Name="RevitRunningText" HorizontalAlignment="Right" FontSize="12" Foreground="#94A3B8" />
                </Grid>

                <ItemsControl x:Name="RevitListControl" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Content="{Binding StatusText}"
                                      Foreground="#E2E8F0"
                                      FontSize="13"
                                      Margin="0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Cài đặt / Cập nhật Add-in" Click="OnInstallConnectorsClick" Margin="0,0,10,0" />
                    <Button Content="Gỡ Add-in đã chọn" Background="#991B1B" Click="OnUninstallConnectorsClick" Margin="0,0,10,0" />
                    <Button Content="Quét lại" Background="#334155" Click="OnRefreshRevitClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Info Strip -->
        <TextBlock x:Name="CatalogInfoText" Grid.Row="3" Text="Catalog: -" FontSize="12" Foreground="#94A3B8" Margin="4,0,0,8" />

        <!-- Activity Log -->
        <Border Grid.Row="4" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="10">
            <TextBox x:Name="LogBox"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="#CBD5E1"
                     FontFamily="Consolas"
                     FontSize="12"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</Window>
